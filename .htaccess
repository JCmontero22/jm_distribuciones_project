# ============================================================
# PRODUCCIÓN (activo)
# La entrada del sistema es index.php en la raíz del proyecto.
# ============================================================
RewriteEngine On
# Sin RewriteBase: Apache usa la carpeta de este .htaccess como base,
# así funciona tanto en la raíz del dominio como en una subcarpeta (XAMPP).

# Carpetas internas: no accesibles desde el navegador
RewriteRule ^(\.git|\.agents|\.codex|config|db|scripts|logs)(/|$) - [F,L]

# Endpoints AJAX responden directamente (JSON)
RewriteRule ^ajax/ - [L,NC]

# Archivos y carpetas reales se sirven tal cual; el resto va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

DirectoryIndex index.php

# Proteger archivos sensibles
<FilesMatch "\.(env|sql|log|ini|sh|bat|inc|bak|config|php~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

