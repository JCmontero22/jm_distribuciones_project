<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /PROYECTO_JM-ML/distribuciones_jm/jm_distribuciones_project/

    # No reescribir endpoints AJAX (deben responder JSON directamente)
    RewriteRule ^ajax/ - [L,NC]

    # No reescribir assets u otros archivos reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
